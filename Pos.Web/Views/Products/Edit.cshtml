@model Pos.Web.Models.Api.CreateProductDto
@{
    ViewData["Title"] = "Editar producto";
    var id = (int)ViewBag.Id;
}

<h3 class="mb-3"><i class="bi bi-pencil"></i> Editar producto</h3>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="post" asp-route-id="@id" class="row g-3">
    <div class="col-md-4">
        <label class="form-label">SKU</label>
        <input class="form-control" asp-for="Sku" />
    </div>

    <div class="col-md-8">
        <label class="form-label">Nombre</label>
        <input class="form-control" asp-for="Name" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Precio</label>
        <input class="form-control" asp-for="Price" type="number" step="0.01" min="0" />
    </div>

    <div class="col-md-4">
        <label class="form-label">IEPS (ej. 0.26)</label>
        <select id="payMethod" class="form-select" asp-for="IepsRate">
            <option value="0.265">Ieps 26.5%</option>
            <option value="0.30">Ieps 30%</option>
            <option value="0.53">Ieps 53%</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Stock</label>
        <input class="form-control" asp-for="Stock" type="number" step="1" min="0" />
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> Guardar</button>
        <a class="btn btn-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
</form>
