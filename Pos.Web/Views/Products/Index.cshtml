@model List<Pos.Web.Models.Api.ProductDto>
@{
    ViewData["Title"] = "Productos";
    var search = (string)(ViewBag.Search ?? "");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-box-seam"></i> Productos</h3>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo</a>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-md-8">
        <input class="form-control" name="search" value="@search" placeholder="Buscar por SKU o nombre..." />
    </div>
    <div class="col-md-4">
        <button class="btn btn-outline-dark w-100"><i class="bi bi-search"></i> Buscar</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Nombre</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Stock</th>
            <th style="width:160px;"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Sku</td>
            <td>@p.Name</td>
            <td class="text-end">@p.Price.ToString("0.00")</td>
            <td class="text-end">@p.Stock</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id" title="Editar">
                    <i class="bi bi-pencil"></i>
                </a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar producto?');">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>